{
  "name": "divebell",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.18.1 <11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --workspace-concurrency=1 --if-present run build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "check": "pnpm run version:check && pnpm run build && pnpm run docs:cli:check -- --no-build && pnpm run test:release-script && pnpm run test && pnpm run verify:stage7 && pnpm run evaluate:stage6:run",
    "docs:cli": "node ./scripts/sync-divebell-cli-docs.mjs",
    "build:recording-runtime": "node ./scripts/build-recording-skill-runtime.mjs",
    "verify:recording-runtime": "node ./scripts/verify-recording-skill-runtime.mjs",
    "docs:cli:check": "node ./scripts/sync-divebell-cli-docs.mjs --check",
    "evaluate:stage6": "pnpm run build && pnpm run evaluate:stage6:run",
    "evaluate:stage6:run": "node ./scripts/evaluate-stage6.mjs",
    "verify:stage7": "node ./scripts/verify-stage7-release.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:npm:check": "node ./scripts/npm-release.mjs check",
    "release:npm:pack": "node ./scripts/npm-release.mjs pack",
    "sync:mf-observability": "node ./packages/extension-mf/scripts/sync-observability.mjs sync",
    "check:mf-observability": "node ./packages/extension-mf/scripts/sync-observability.mjs check",
    "test:release-script": "node --test ./scripts/npm-release-utils.test.mjs ./scripts/release-pr-body-utils.test.mjs",
    "publish:packages": "node ./scripts/npm-release.mjs publish",
    "version:check": "node ./scripts/check-package-versions.mjs",
    "clean": "node ./scripts/clean.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@divebell/cli": "workspace:^",
    "@types/node": "24.13.1",
    "esbuild": "0.28.1",
    "pkg-pr-new": "0.0.75",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
