{
  "name": "@openruntime/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "open-runtime": "./dist/index.js",
    "openruntime": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "test": "pnpm run build && tsc -p tsconfig.test.json --pretty false && rstest run"
  },
  "dependencies": {
    "@openruntime/bridge": "workspace:^",
    "@openruntime/core": "workspace:^"
  },
  "devDependencies": {
    "@rstest/core": "0.10.3"
  }
}
