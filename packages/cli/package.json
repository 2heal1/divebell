{
  "name": "@openruntime/cli",
  "version": "0.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/openruntime.git",
    "directory": "packages/cli"
  },
  "author": "2heal1",
  "bin": {
    "openruntime": "./dist/bin.js",
    "opr": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "assets/**/*",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "test": "pnpm run build && node ../../scripts/validate-command-output.mjs --self-test && tsc -p tsconfig.test.json --pretty false && rstest run"
  },
  "dependencies": {
    "@openruntime/agent-browser": "0.32.0-openruntime.1",
    "@openruntime/bridge": "workspace:^",
    "@openruntime/core": "workspace:^"
  },
  "devDependencies": {
    "@rstest/core": "0.10.3"
  }
}
