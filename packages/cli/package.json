{
  "name": "@divebell/cli",
  "version": "0.0.15",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/divebell.git",
    "directory": "packages/cli"
  },
  "author": "2heal1",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "bin": {
    "divebell": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "skills/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "prepublish": "node ./scripts/copy-cli-skill.mjs",
    "test": "pnpm run build && pnpm run prepublish && node ../../scripts/validate-command-output.mjs --self-test && tsc -p tsconfig.test.json --pretty false && rstest run",
    "test:browser-e2e": "pnpm run build && node test/browser-commands.e2e.mjs"
  },
  "dependencies": {
    "@divebell/agent-browser": "0.33.2-divebell.4",
    "@divebell/bridge": "workspace:^",
    "@divebell/core": "workspace:^"
  },
  "devDependencies": {
    "@rstest/core": "0.10.3"
  }
}
