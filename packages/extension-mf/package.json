{
  "name": "@openruntime/extension-mf",
  "version": "0.1.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/openruntime.git",
    "directory": "packages/extension-mf"
  },
  "author": "2heal1",
  "main": "./dist/package.js",
  "types": "./dist/package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package.d.ts",
      "import": "./dist/package.js",
      "default": "./dist/package.js"
    },
    "./core": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    }
  },
  "openruntime": {
    "schemaVersion": 1,
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/observability-build.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false && node ./scripts/assemble.mjs",
    "test": "pnpm run build && node --test test/*.test.mjs"
  }
}
