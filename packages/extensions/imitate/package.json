{
  "name": "@divebell/extension-imitate",
  "version": "0.0.16",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/divebell.git",
    "directory": "packages/extensions/imitate"
  },
  "author": "2heal1",
  "main": "./dist/index.js",
  "divebell": {
    "schemaVersion": 1,
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "skills/**/*.md",
    "skills/**/*.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "test:replay-e2e": "pnpm run build && node test/recording-replay.e2e.mjs"
  }
}
