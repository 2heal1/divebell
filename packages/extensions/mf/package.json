{
  "name": "@divebell/extension-mf",
  "version": "0.0.26",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/divebell.git",
    "directory": "packages/extensions/mf"
  },
  "author": "2heal1",
  "main": "./dist/package.js",
  "types": "./dist/package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package.d.ts",
      "import": "./dist/package.js",
      "default": "./dist/package.js"
    },
    "./core": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "default": "./dist/extension.js"
    },
    "./test": {
      "types": "./dist/test-commands.d.ts",
      "import": "./dist/test-commands.js",
      "default": "./dist/test-commands.js"
    }
  },
  "divebell": {
    "schemaVersion": 1,
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/observability-build.json",
    "dist/runtime-debug-build.json",
    "dist/proxy-sdk-build.json",
    "skills/**/*.md",
    "skills/**/*.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -b --pretty false && node ./scripts/assemble.mjs",
    "sync:vmok-proxy": "node ./scripts/sync-vmok-proxy.mjs sync",
    "check:vmok-proxy": "node ./scripts/sync-vmok-proxy.mjs check",
    "test": "pnpm run build && node --test test/*.test.mjs"
  }
}
