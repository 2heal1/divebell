{
  "name": "@divebell/extension-rstack",
  "version": "0.0.25",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/divebell.git",
    "directory": "packages/extensions/rstack"
  },
  "author": "2heal1",
  "main": "./dist/package.js",
  "types": "./dist/package.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package.d.ts",
      "import": "./dist/package.js",
      "default": "./dist/package.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "default": "./dist/extension.js"
    }
  },
  "divebell": {
    "schemaVersion": 1,
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "skills/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "test": "pnpm run build && node --test test/*.test.mjs"
  }
}
