{
  "name": "@divebell/test",
  "version": "0.0.3",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2heal1/divebell.git",
    "directory": "packages/test"
  },
  "author": "2heal1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "divebell-test": "./bin/divebell-test.js"
  },
  "files": [
    "bin/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/e2e/**/*",
    "scripts/**/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/prepare-package.mjs",
    "prepack": "pnpm run build",
    "test:e2e": "pnpm run build && node ./bin/divebell-test.js"
  },
  "dependencies": {
    "@divebell/bridge": "workspace:^",
    "@divebell/cli": "workspace:^",
    "@divebell/core": "workspace:^",
    "@divebell/extension-code-usage": "workspace:^",
    "@divebell/extension-imitate": "workspace:^",
    "@divebell/extension-memory": "workspace:^",
    "@divebell/extension-mf": "workspace:^",
    "@divebell/extension-troubleshooting": "workspace:^"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
